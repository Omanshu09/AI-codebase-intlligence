# Copy this file to .env and fill in what you need.
# The app works with ZERO keys set (free/local mode) -- embeddings run locally
# via fastembed (ONNX Runtime, no PyTorch) and the vector DB (Chroma) is
# stored on disk.
# Without an LLM key, /query returns the retrieved code chunks with a
# templated summary instead of an LLM-generated explanation.

# Optional: enables real LLM-generated answers
ANTHROPIC_API_KEY=

# Where application metadata (repos, files, queries) is stored.
# Defaults to a local SQLite file so you can run everything for free
# with no external database. In docker-compose this is overridden to
# point at the postgres service.
DATABASE_URL=sqlite:///./data/app.db

# Where Chroma persists its vector index on disk
CHROMA_PERSIST_DIR=./data/chroma

# Local embedding model, loaded via fastembed (ONNX Runtime, no PyTorch --
# this matters a lot on memory-capped free-tier hosts)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Directory used to clone repositories into temporarily
CLONE_DIR=./data/repos

# Max chunks sent to the LLM as context per query
TOP_K=5
